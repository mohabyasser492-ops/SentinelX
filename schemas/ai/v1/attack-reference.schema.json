{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sentinelx.local/ai/v1/attack-reference.schema.json",
  "title": "ATT&CK Reference",
  "description": "Evidence-backed reference to an ATT&CK technique.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "technique_id",
    "knowledge_source_version",
    "confidence",
    "evidence"
  ],
  "properties": {
    "technique_id": {
      "type": "string",
      "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
    },
    "knowledge_source_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../../common/v1/evidence-reference.schema.json"
      }
    }
  }
}