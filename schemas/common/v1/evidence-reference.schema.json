{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sentinelx.local/common/v1/evidence-reference.schema.json",
  "title": "SentinelX Evidence Reference",
  "description": "A field-level reference to evidence supporting an analysis conclusion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "role",
    "field_paths"
  ],
  "properties": {
    "event_id": {
      "$ref": "identifier.schema.json"
    },
    "role": {
      "type": "string",
      "enum": [
        "primary",
        "supporting",
        "contradicting"
      ]
    },
    "field_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    }
  }
}