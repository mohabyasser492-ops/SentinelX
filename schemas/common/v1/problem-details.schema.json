{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sentinelx.local/common/v1/problem-details.schema.json",
  "title": "SentinelX Problem Details",
  "description": "Machine-readable error contract returned by SentinelX services.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "title",
    "status",
    "detail",
    "code",
    "retryable"
  ],
  "properties": {
    "type": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "detail": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "instance": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "code": {
      "type": "string",
      "pattern": "^SX-[A-Z]+-[0-9]{3}$"
    },
    "retryable": {
      "type": "boolean"
    },
    "field_errors": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}