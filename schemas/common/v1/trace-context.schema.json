{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sentinelx.local/common/v1/trace-context.schema.json",
  "title": "SentinelX Trace Context",
  "description": "Distributed tracing context propagated across SentinelX services.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "traceparent"
  ],
  "properties": {
    "traceparent": {
      "type": "string",
      "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
    },
    "tracestate": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    }
  }
}