{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sentinelx/security-event/v1",
  "title": "SentinelX Security Event v1",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "timestamp",
    "source",
    "event_type"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "enum": [
        "wazuh",
        "sysmon",
        "suricata",
        "replay"
      ]
    },
    "event_type": {
      "type": "string"
    },
    "host": {
      "type": [
        "string",
        "null"
      ]
    },
    "user": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ip": {
      "type": [
        "string",
        "null"
      ]
    },
    "destination_ip": {
      "type": [
        "string",
        "null"
      ]
    },
    "process": {
      "type": [
        "object",
        "null"
      ]
    },
    "raw_event_reference": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}